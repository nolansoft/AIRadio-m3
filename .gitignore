# ─── Gradle ──────────────────────────────────────────────────────────────
.gradle/
/build/
/app/build/
/captures/

# ─── Android Studio / IntelliJ ───────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr

# ─── Local SDK / JDK config (per-machine) ────────────────────────────────
local.properties

# ─── Crash logs and verification screenshots (transient) ────────────────
crash_log.txt
crash_log2.txt
crash_buffer.txt
verify_*.png
verify_*.txt

# ─── Runtime / orchestration state ──────────────────────────────────────
.omc/
.sisyphus/
.superpowers/

# ─── OS junk ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Build outputs (defensive; usually absent from VCS by default) ──────
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class

# ─── Signing keys (NEVER commit) ────────────────────────────────────────
# Release / upload keystores bind the APK signature to a developer identity.
# Leaking them allows anyone to publish updates under the same package name.
# Credentials (store/key passwords) live in local.properties which is
# already excluded above; the keystore files themselves must also be excluded.
*.jks
*.keystore
*.p12
*.pfx

# ─── Editor / OS duplicate and backup files ─────────────────────────────
# CJK-localized "copy" suffix (e.g. "gradle-wrapper - 副本.properties")
*副本*
# Space-dash-space pattern, common to Chinese/Western editor copy commands
* - *.*
# Generic backup suffixes
*.bak
*~
