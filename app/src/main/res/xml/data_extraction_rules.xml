<!-- Data extraction rules define which files are extracted from the app for
     backup and transfer to a new device. See
     https://developer.android.com/about/versions/12/features/data-extraction
     for details. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <exclude domain="sharedpref" path="com.google.android.apps.common.proguard.flags.xml"/>
        <!-- Listening history (favorites + recently-played Room tables) is private and excluded from cloud backup. -->
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <exclude domain="sharedpref" path="com.google.android.apps.common.proguard.flags.xml"/>
        <!-- Listening history (favorites + recently-played Room tables) is private and excluded from device transfer. -->
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
